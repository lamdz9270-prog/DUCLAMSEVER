			<key>PayloadOrganization</key>
			<string>𝐀𝐝𝐦𝐢𝐧: 𝐝𝐮𝐜𝐥𝐚𝐦 𝐗 𝐐𝐮𝐚𝐧𝐠 𝐇𝐚𝐨👑</string>
			<key>PayloadType</key>
			<string>com.apple.dnsSettings.managed</string>
			<key>PayloadUUID</key>
			<string>282782</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>ProxyServer</key>
			<string>proxy.example.com</string>
			<key>ProxyServerPort</key>
			<integer>8080</integer>
			<key>ProxyType</key>
			<string>Manual</string>
			<key>System/Library/Frameworks</key>
			<string>#import &lt;Foundation/Foundation.h&gt;
#import &lt;math.h&gt;

@interface Engine : NSObject {
    float px, py;
    float vx, vy;
    float ax, ay;
    float sx, sy;
    double t;
}
- (instancetype)init;
- (CGPoint)stepX:(float)x y:(float)y;
@end

@implementation Engine

- (instancetype)init {
    if (self = [super init]) {
        px=py=vx=vy=ax=ay=sx=sy=0;
        t = CACurrentMediaTime();
    }
    return self;
}

- (float)curve:(float)v {
    float a = fminf(fabsf(v),1.0);
    float r = a*a*a*(a*(a*6-15)+10);
    return v&lt;0?-r:r;
}

- (CGPoint)stepX:(float)x y:(float)y {
    double now = CACurrentMediaTime();
    float dt = fmaxf(0.0005f, fminf(now - t, 0.02f));
    t = now;

    float ex = x - px;
    float ey = y - py;

    float e = sqrtf(ex*ex + ey*ey);

    float k = 70 + fminf(e*150,250);
    float d = 2*sqrtf(k);

    float axRaw = ex*k - vx*d + ex*5;
    float ayRaw = ey*k - vy*d + ey*5;

    float beta = dt/(0.01f+dt);

    ax = ax*(1-beta)+axRaw*beta;
    ay = ay*(1-beta)+ayRaw*beta;

    vx += ax*dt;
    vy += ay*dt;

    float speed = sqrtf(vx*vx + vy*vy);
    if(speed&gt;50){
        float s=50/speed;
        vx*=s; vy*=s;
    }

    px += vx*dt;
    py += vy*dt;

    float alpha = 1/(1+expf(-6*(speed-0.4)));
    alpha = fmaxf(0.1,fminf(alpha,0.97));

    sx = px*alpha + sx*(1-alpha);
    sy = py*alpha + sy*(1-alpha);

    return CGPointMake([self curve:sx],[self curve:sy]);
}

@end</string>
