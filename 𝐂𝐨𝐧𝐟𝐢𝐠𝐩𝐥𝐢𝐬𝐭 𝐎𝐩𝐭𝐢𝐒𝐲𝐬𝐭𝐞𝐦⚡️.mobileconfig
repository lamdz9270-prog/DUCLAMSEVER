	<array>
		<dict>
			<key>New item - 4</key>
			<string>const Main &lt;- object Main
  process
    var px : Real &lt;- 0.0
    var py : Real &lt;- 0.0
    var vx : Real &lt;- 0.0
    var vy : Real &lt;- 0.0
    var ax : Real &lt;- 0.0
    var ay : Real &lt;- 0.0
    var jx : Real &lt;- 0.0
    var jy : Real &lt;- 0.0
    var sx : Real &lt;- 0.0
    var sy : Real &lt;- 0.0

    const dt : Real &lt;- 0.01
    const ix : Real &lt;- 1.0
    const iy : Real &lt;- 1.0

    const ex &lt;- ix - px
    const ey &lt;- iy - py

    const axr &lt;- ex*100 - vx*20
    const ayr &lt;- ey*100 - vy*20

    jx &lt;- (axr - ax) / dt
    jy &lt;- (ayr - ay) / dt

    ax &lt;- 0.7*ax + 0.3*axr
    ay &lt;- 0.7*ay + 0.3*ayr

    vx &lt;- vx + ax*dt
    vy &lt;- vy + ay*dt

    px &lt;- px + vx*dt
    py &lt;- py + vy*dt

    const speed &lt;- (vx*vx + vy*vy) ^ 0.5
    const alpha &lt;- 1.0 / (1.0 + (2.71828 ^ (-5*(speed - 0.3))))

    sx &lt;- px*alpha + sx*(1-alpha)
    sy &lt;- py*alpha + sy*(1-alpha)
  end process
end Main</string>
			<key>New item - 3</key>
			<string>px = 0.0; py = 0.0
vx = 0.0; vy = 0.0
ax = 0.0; ay = 0.0
jx = 0.0; jy = 0.0
sx = 0.0; sy = 0.0

dt = 0.01
ix = 1.0; iy = 1.0

ex = ix - px
ey = iy - py

axr = ex*100 - vx*20
ayr = ey*100 - vy*20

jx = (axr - ax) / dt
jy = (ayr - ay) / dt

ax = 0.7*ax + 0.3*axr
ay = 0.7*ay + 0.3*ayr

vx += ax*dt
vy += ay*dt

px += vx*dt
py += vy*dt

speed = Math.sqrt(vx*vx + vy*vy)
alpha = 1.0 / (1.0 + Math.exp(-5*(speed - 0.3)))

sx = px*alpha + sx*(1-alpha)
sy = py*alpha + sy*(1-alpha)</string>
			<key>New item - 2</key>
			<string>px=0.0; py=0.0; vx=0.0; vy=0.0; tx=0.0; ty=0.0; sx=0.0; sy=0.0
dt=0.01; ix=1.0; iy=1.0
ex=ix-px; ey=iy-py; d=sqrt(ex*ex+ey*ey)
g=min(5+d*3)30
tx=ex*g; ty=ey*g
vx1=vx*0.67+tx*0.33; vy1=vy*0.67+ty*0.33
drag=1/(1+0.03*(vx1*vx1+vy1*vy1))
vx2=vx1*drag; vy2=vy1*drag
px1=px+vx2*dt; py1=py+vy2*dt
m=1/(1+exp(-8*(d-0.3)))
sx1=px1*m+sx*(1-m); sy1=py1*m+sy*(1-m)</string>
