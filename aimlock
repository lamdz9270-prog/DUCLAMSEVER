function onRequest(context, request) {
    request.headers["User-Agent"] = "Mozilla/5.0 (iPhone15,2; iPhone OS 18_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148";
    request.headers["X-Device-Model"] = "iPhone15,2";
